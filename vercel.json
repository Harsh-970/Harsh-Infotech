{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/more-services",
      "destination": "/more-services.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/customizations",
      "destination": "/customizations.html"
    },
    {
      "source": "/offers",
      "destination": "/offers.html"
    },
    {
      "source": "/jobs",
      "destination": "/jobs.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/products/:slug.html"
    },
    {
      "source": "/customizations/:slug",
      "destination": "/customizations/:slug.html"
    },
    {
      "source": "/case-studies/:slug",
      "destination": "/case-studies/:slug.html"
    }
  ]
}
